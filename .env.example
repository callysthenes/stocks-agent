# ============================================================
# StocksAgent — Environment Configuration Template
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# ============================================================

# ── DeepSeek API ─────────────────────────────────────────────
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ── Telegram ─────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_CHAT_ID=  # Leave blank; auto-set on first /start

# ── MariaDB ──────────────────────────────────────────────────
MARIADB_HOST=mariadb
MARIADB_PORT=3306
MARIADB_DATABASE=stocks_agent
MARIADB_USER=appuser
MARIADB_PASSWORD=change-me-strong-password
MARIADB_ROOT_PASSWORD=change-me-root-password

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── ChromaDB ─────────────────────────────────────────────────
CHROMADB_HOST=chromadb
CHROMADB_PORT=8000

# ── Ollama ───────────────────────────────────────────────────
OLLAMA_HOST=http://ollama:11434

# ── Langfuse (self-hosted observability) ─────────────────────
LANGFUSE_SECRET_KEY=change-me-langfuse-secret
LANGFUSE_PUBLIC_KEY=change-me-langfuse-public
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_DB_PASSWORD=change-me-langfuse-db-password
LANGFUSE_NEXTAUTH_SECRET=change-me-32-char-secret
LANGFUSE_SALT=change-me-salt

# ── Embedding Model ───────────────────────────────────────────
# bge-m3 is best for Spanish financial text (100+ languages)
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cuda
EMBEDDING_BATCH_SIZE=32

# ── Whisper Transcription ────────────────────────────────────
WHISPER_MODEL=large-v3
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16

# ── Processing ───────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=50
MAX_VIDEOS_PER_FETCH=5

# ── API ──────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO
ENVIRONMENT=production

# ── Report Schedule (UTC) ────────────────────────────────────
DAILY_REPORT_HOUR_UTC=22
DAILY_REPORT_MINUTE_UTC=30
PREDICTION_EVAL_HOUR_UTC=22
PREDICTION_EVAL_MINUTE_UTC=0
CHANNEL_POLL_INTERVAL_MINUTES=30

# ── Dashboard ────────────────────────────────────────────────
DASHBOARD_URL=http://localhost:8501

# ── Cloudflare Quick Tunnel ───────────────────────────────────
# Run scripts/tunnel-start.sh (or the stocks-tunnel systemd user service)
# to expose the dashboard publicly. The URL is sent via Telegram on each start.
# See: systemctl --user enable stocks-tunnel.service
